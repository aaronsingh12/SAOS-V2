{
  "kind": "subflow",
  "subflow": "Add Priority Check Work Note",
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Test incident for priority check work note"
    }
  },
  "inputs": {
    "incident": "{{setup.sys_id}}"
  },
  "wait": {
    "timeoutSec": 120
  },
  "assert": [
    {
      "table": "sys_journal_field",
      "locate": {
        "byQuery": "element=work_notes^element_id={{setup.sys_id}}"
      },
      "field": "value",
      "expect": {
        "value": "Priority checked by onboarding subflow"
      },
      "note": "adds work note \"Priority checked by onboarding subflow\" to the incident"
    }
  ],
  "expectOutputs": [],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "sys_journal_field",
      "locate": {
        "byQuery": "element=work_notes^element_id={{setup.sys_id}}"
      }
    }
  ]
}