{
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Test critical incident",
      "impact": "1",
      "urgency": "1"
    }
  },
  "wait": {
    "flowName": "Set Critical Incident to In Progress",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "state",
      "expect": {
        "value": "2"
      },
      "note": "sets state to In Progress"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "Critical incident detected."
      },
      "note": "adds work note \"Critical incident detected.\""
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    }
  ]
}