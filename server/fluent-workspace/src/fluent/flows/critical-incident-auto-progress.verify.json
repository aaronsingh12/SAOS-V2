{
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Critical test incident",
      "impact": "1",
      "urgency": "1"
    }
  },
  "wait": {
    "flowName": "Critical Incident Auto-Progress",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "state",
      "expect": {
        "value": "2"
      },
      "note": "sets incident state to In Progress (2)"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "Critical incident detected and moved to In Progress."
      },
      "note": "adds a work note \"Critical incident detected and moved to In Progress.\""
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "Critical incident has no assigned user."
      },
      "note": "adds a work note \"Critical incident has no assigned user.\""
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    }
  ]
}