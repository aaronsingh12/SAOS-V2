{
  "setup": {
    "table": "incident",
    "payload": {
      "category": "network",
      "short_description": "Network test incident"
    }
  },
  "wait": {
    "flowName": "Auto-Assign Network Incidents",
    "timeoutSec": 90
  },
  "assert": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "assignment_group",
      "expect": {
        "display": "Network"
      },
      "note": "sets assignment_group to Network team group"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "priority",
      "expect": {
        "display": "2 - High"
      },
      "note": "sets priority to 2 (High)"
    },
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      },
      "field": "work_notes",
      "expect": {
        "value": "Incident automatically assigned to Network team."
      },
      "note": "adds work note \"Incident automatically assigned to Network team.\""
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    }
  ]
}