{
  "kind": "subflow",
  "subflow": "Demo Helper Subflow",
  "setup": {
    "table": "incident",
    "payload": {
      "short_description": "Test incident"
    }
  },
  "inputs": {
    "incident_sys_id": "{{setup.sys_id}}",
    "short_description": "Test incident"
  },
  "wait": {
    "timeoutSec": 120
  },
  "assert": [
    {
      "table": "sys_journal_field",
      "locate": {
        "byQuery": "element=work_notes^element_id={{setup.sys_id}}"
      },
      "field": "value",
      "expect": {
        "value": "Processed by subflow"
      },
      "note": "adds a work note to the incident"
    }
  ],
  "expectOutputs": [
    {
      "name": "status",
      "expect": {
        "value": "Subflow completed for Test incident"
      },
      "note": "status output contains the short description"
    }
  ],
  "cleanup": [
    {
      "table": "incident",
      "locate": {
        "bySetupRecord": true
      }
    },
    {
      "table": "sys_journal_field",
      "locate": {
        "byQuery": "element=work_notes^element_id={{setup.sys_id}}"
      }
    }
  ]
}